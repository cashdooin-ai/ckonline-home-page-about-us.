# CollegeKampus Online Portal — /dashboard subfolder
# Prevents WordPress (at parent domain root) from intercepting these PHP files

# Stop WordPress rewrite rules from propagating into this folder
RewriteEngine Off

# Serve index.html as default document (About Us page)
DirectoryIndex index.html portal.html index.php

# PHP settings for Hostinger shared hosting
php_value upload_max_filesize 10M
php_value post_max_size 10M
php_value max_execution_time 60

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Block direct access to config files
<FilesMatch "^(db\.php|constants\.php)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Protect sensitive directories
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^config/ - [F,L]
    RewriteRule ^database/ - [F,L]

    # Clean URLs for slug-based detail pages
    # /college/some-university -> college-detail.php?slug=some-university
    RewriteRule ^college/([a-zA-Z0-9_-]+)/?$ college-detail.php?slug=$1 [L,QSA]
    # /blog/some-article -> blog-post.php?slug=some-article
    RewriteRule ^blog/([a-zA-Z0-9_-]+)/?$ blog-post.php?slug=$1 [L,QSA]

    # Clean URLs for top-level static/marketing pages (SEO-friendly, no
    # .php extension). courses.php and index.php are intentionally left
    # alone: courses/ is a real subdirectory serving its own stream pages
    # (e.g. /dashboard/courses/online-mba), and index.php is reachable only
    # by its full path today since index.html (the About Us page) is the
    # actual DirectoryIndex for "/".
    RewriteRule ^ck-assured/?$ ck-assured.php [L,QSA]
    RewriteRule ^colleges/?$ colleges.php [L,QSA]
    RewriteRule ^compare/?$ compare.php [L,QSA]
    RewriteRule ^counselling/?$ counselling.php [L,QSA]
    RewriteRule ^coupons/?$ coupons.php [L,QSA]
    RewriteRule ^suggest/?$ suggest.php [L,QSA]
    RewriteRule ^roi-calculator/?$ tools/roi-calculator.php [L,QSA]
    RewriteRule ^blog/?$ blog.php [L,QSA]
    RewriteRule ^contact/?$ contact.php [L,QSA]
    RewriteRule ^privacy-policy/?$ privacy-policy.php [L,QSA]
    RewriteRule ^terms/?$ terms.php [L,QSA]
</IfModule>

# Enable GZIP compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# Browser caching for assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
</IfModule>
